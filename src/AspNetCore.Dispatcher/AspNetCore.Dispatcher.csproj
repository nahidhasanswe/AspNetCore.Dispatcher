<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net9.0</TargetFrameworks>
    <RootNamespace>AspNetCore.Dispatcher</RootNamespace>
    <AssemblyName>AspNetCore.Dispatcher</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Label="Package identity">
    <PackageId>AspNetCore.Dispatcher</PackageId>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>preview.1</VersionSuffix>
    <Title>AspNetCore.Dispatcher</Title>
    <Authors>Nahid</Authors>
    <Company>Nahid</Company>
    <Copyright>Copyright (c) 2026 Nahid</Copyright>
  </PropertyGroup>

  <PropertyGroup Label="Package description">
    <Description>In-process messaging for .NET: send a request to a single handler, publish a notification to many, stream results with IAsyncEnumerable, and wrap it all in a pipeline of behaviors, pre/post processors and exception handlers. A complete, MediatR-compatible API surface under the AspNetCore.Dispatcher namespace, with assembly scanning for Microsoft.Extensions.DependencyInjection.</Description>
    <PackageTags>mediator;dispatcher;cqrs;mediatr;request;response;notification;pipeline;messaging;aspnetcore</PackageTags>
    <PackageReleaseNotes>First preview. Requests, commands/queries, void requests, notifications, streaming requests, pipeline and stream behaviors, pre/post processors, exception handlers and actions, pluggable notification publishers, and assembly-scanning registration. Full release notes: https://github.com/nahidhasanswe/AspNetCore.Dispatcher/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Label="Package links and license">
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/nahidhasanswe/AspNetCore.Dispatcher</PackageProjectUrl>
    <RepositoryUrl>https://github.com/nahidhasanswe/AspNetCore.Dispatcher.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Symbols and source link">
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup Label="Files packed alongside the assemblies">
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AspNetCore.Dispatcher.Tests" />
  </ItemGroup>

</Project>
